			mabai = ma;
			kichthuoc = kt;
			co1=co2=co3 =false;
		}
		int layma() const {return mabai;}
		char laykichthuoc() const {return kichthuoc;}
		int succhua () const {
			if (kichthuoc == 'S')
				return 1;
			else if (kichthuoc == 'M') {
				return 2;
			}
			else if(kichthuoc == 'L'){
				return 3;
			}
			return 0;
		}
